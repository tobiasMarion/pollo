# Copy to .env (which is git-ignored). The server validates this at boot and
# fails fast with a readable error if anything is missing — see apps/backend/src/env.ts

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# A line per request is what you want while building a route and the last thing
# you want while measuring one — a simulated crowd joining is one log line per
# device, competing for the event loop the run is trying to measure. Set false
# before a load test; the metrics report is unaffected either way.
LOG_REQUESTS=true

# Datastores (match infra/compose.dev.yaml)
DATABASE_URL="postgresql://pollo:pollo@localhost:5432/pollo?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth — generate a real secret: openssl rand -hex 32
JWT_SECRET="dev-secret-change-me"

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID="your-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-client-secret"
GITHUB_OAUTH_CLIENT_REDIRECT_URI="http://localhost:3000/api/auth/callback"
# Production: https://pollo.tobiasmarion.com/app/api/auth/callback

# Admin panel (apps/web). Reached by the browser too, so it must be an address
# the operator's machine can resolve — not a compose service name.
PUBLIC_POLLO_API_URL="http://localhost:3333"
# Production: https://pollo.tobiasmarion.com/api/

# Where the panel itself is served. Production only: adapter-node checks the
# Origin of form posts against it. The compose network address of the API is
# set in compose.prod.yaml, not here.
WEB_ORIGIN="http://localhost:3000"
# Production: https://pollo.tobiasmarion.com

# Position worker (apps/worker). It reads REDIS_URL above and nothing else from
# the section that precedes this one — no database, no JWT, no OAuth. Everything
# here has a default; it is here to be turned, not to be filled in.

# How often a live event is solved and published. The ingest window is 250 ms, so
# a faster tick is not about seeing more data — it is about spending more
# iterations on the data already in.
WORKER_TICK_MS=33

# Ticks between full keyframes, and how far a pixel must move before a delta is
# worth sending. Together they decide how much of the crowd crosses the wire.
WORKER_KEYFRAME_TICKS=90
WORKER_PUBLISH_EPSILON_M=0.05

# Entries kept on each positions stream, and points per message. A keyframe of
# fifty thousand pixels is not one XADD, and a stream nobody trims is a memory
# leak with a schedule.
WORKER_POSITIONS_MAXLEN=1000
WORKER_POINTS_PER_MESSAGE=500

# Only used by the production compose (infra/compose.prod.yaml)
POSTGRES_PASSWORD="change-me-in-prod"

# Optional image overrides used by deployment. GitHub Actions writes these to
# release.env on the VPS, pinned to the commit SHA; local builds use :local.
# POLLO_API_IMAGE="ghcr.io/tobiasmarion/pollo-api:<commit-sha>"
# POLLO_WEB_IMAGE="ghcr.io/tobiasmarion/pollo-web:<commit-sha>"
# POLLO_WORKER_IMAGE="ghcr.io/tobiasmarion/pollo-worker:<commit-sha>"
