{
  "name": "@pollo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turns the distance graph into coordinates \u2014 the only process in Pollo that simulates anything",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@pollo/contracts": "*",
    "@pollo/geometry": "*",
    "ioredis": "^5.6.1",
    "pino": "^9.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^20.12.7",
    "ioredis-mock": "^8.9.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
