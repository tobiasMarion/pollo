{
  "name": "@pollo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wire contracts shared by every Pollo client — Zod schemas, the types inferred from them and the documentation they carry",
  "exports": {
    ".": {
