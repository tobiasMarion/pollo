{
  "name": "@pollo/geometry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The maths Pollo is made of \u2014 vectors, geodesy and the multidimensional scaling the worker solves with. No wire, no IO, no opinions about devices",
  "exports": {
    ".": {
